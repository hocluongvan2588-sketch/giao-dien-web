# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server, KHÔNG để lộ ra trình duyệt
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email được quyền vào /admin (phân cách bằng dấu phẩy)
ADMIN_EMAILS=admin@veximglobal.com

# ---- Thanh toán VietQR + SePay ----
# Mã ngân hàng theo VietQR (VD: MB, VCB, TCB, ACB, BIDV...)
NEXT_PUBLIC_BANK_ID=MB
NEXT_PUBLIC_BANK_ACCOUNT_NO=0123456789
NEXT_PUBLIC_BANK_ACCOUNT_NAME=CONG TY VEXIM GLOBAL
# API key cấu hình trong SePay → Webhooks (kiểu xác thực "API Key")
SEPAY_WEBHOOK_API_KEY=

# ---- Chụp thumbnail ----
# Để trống khi deploy Vercel (dùng @sparticuz/chromium).
# Khi chạy local, trỏ tới Chrome/Chromium trên máy, VD:
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE_PATH=
